{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowBronzeWriteOnly",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:PutObjectAcl"
            ],
            "Resource": "arn:aws:s3:::mobility-data-lake-269196137263/bronze/*"
        },
        {
            "Sid": "AllowBucketListing",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": "arn:aws:s3:::mobility-data-lake-269196137263"
        }
    ]
}
