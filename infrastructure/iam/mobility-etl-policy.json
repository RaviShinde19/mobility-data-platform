{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowBronzeRead",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion"
            ],
            "Resource": "arn:aws:s3:::mobility-data-lake-269196137263/bronze/*"
        },
        {
            "Sid": "AllowSilverGoldReadWrite",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:PutObject",
                "s3:PutObjectAcl",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::mobility-data-lake-269196137263/silver/*",
                "arn:aws:s3:::mobility-data-lake-269196137263/gold/*"
            ]
        },
        {
            "Sid": "AllowQuarantineWrite",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::mobility-data-lake-269196137263/quarantine/*"
        },
        {
            "Sid": "AllowBucketListing",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": "arn:aws:s3:::mobility-data-lake-269196137263"
        }
    ]
}
